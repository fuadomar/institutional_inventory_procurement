<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Asset Item Form View -->
        <record id="view_asset_item_form" model="ir.ui.view">
            <field name="name">institutional.asset.item.form</field>
            <field name="model">institutional.asset.item</field>
            <field name="arch" type="xml">
                <form string="Institutional Asset Unit">
                    <header>
                        <button name="action_mark_issued" string="Issue / Check-Out Asset" type="object" class="btn-primary" invisible="status == 'issued'"/>
                        <button name="action_mark_returned" string="Return to Store Office" type="object" class="btn-secondary" invisible="status == 'available'"/>
                        <field name="status" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="available,issued,maintenance,scrapped"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Asset Tag / Code"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Asset Identification &amp; Product">
                                <field name="product_id" domain="[('institutional_item_type', '=', 'asset')]"/>
                                <field name="category_id"/>
                                <field name="serial_number" placeholder="Manufacturer Serial Number"/>
                                <field name="condition" widget="radio" options="{'horizontal': true}"/>
                            </group>
                            <group string="Assignment &amp; Valuation">
                                <field name="status"/>
                                <field name="department_id"/>
                                <field name="assigned_user_id"/>
                                <field name="location"/>
                                <field name="acquisition_date"/>
                                <field name="asset_value" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Asset Lifecycle &amp; Custody Trail">
                                <field name="custody_log_ids" readonly="1">
                                    <list string="Custody &amp; Event Logs">
                                        <field name="event_date"/>
                                        <field name="event_type" widget="badge"/>
                                        <field name="previous_holder_id"/>
                                        <field name="new_holder_id"/>
                                        <field name="previous_department_id"/>
                                        <field name="new_department_id"/>
                                        <field name="condition"/>
                                        <field name="notes"/>
                                        <field name="logged_by_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="IT Hardware Components (PCs &amp; Laptops)">
                                <field name="component_ids">
                                    <list editable="bottom">
                                        <field name="component_type"/>
                                        <field name="name"/>
                                        <field name="capacity_or_spec"/>
                                        <field name="serial_number"/>
                                        <field name="condition"/>
                                        <field name="status" widget="badge"/>
                                        <field name="installed_date"/>
                                        <button name="action_detach_component" string="Detach / Decompose" type="object" icon="fa-chain-broken" class="btn-warning btn-sm" title="Detach component as spare"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Component Movement &amp; Swap History Log">
                                <field name="swap_history_ids" readonly="1">
                                    <list string="Component Movement Logs">
                                        <field name="swap_date"/>
                                        <field name="action_type" widget="badge"/>
                                        <field name="component_type"/>
                                        <field name="old_component_name"/>
                                        <field name="new_component_name"/>
                                        <field name="source_asset_id"/>
                                        <field name="dest_asset_id"/>
                                        <field name="technician_id"/>
                                        <field name="reason"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes &amp; Tech Specs">
                                <field name="notes" placeholder="Technical specifications, location details..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Asset Item Tree View -->
        <record id="view_asset_item_tree" model="ir.ui.view">
            <field name="name">institutional.asset.item.tree</field>
            <field name="model">institutional.asset.item</field>
            <field name="arch" type="xml">
                <list string="Institutional Assets &amp; Serialized Items">
                    <field name="currency_id" column_invisible="1"/>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="serial_number"/>
                    <field name="condition"/>
                    <field name="department_id"/>
                    <field name="assigned_user_id"/>
                    <field name="location"/>
                    <field name="asset_value" widget="monetary" sum="Total Asset Value"/>
                    <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'issued'" decoration-danger="status == 'maintenance'"/>
                </list>
            </field>
        </record>

        <!-- Asset Custody Log Tree & Form Views -->
        <record id="view_asset_custody_log_tree" model="ir.ui.view">
            <field name="name">institutional.asset.custody.log.tree</field>
            <field name="model">institutional.asset.custody.log</field>
            <field name="arch" type="xml">
                <list string="Asset Lifecycle &amp; Custody History Logs">
                    <field name="event_date"/>
                    <field name="asset_id"/>
                    <field name="serial_number"/>
                    <field name="event_type" widget="badge"/>
                    <field name="previous_holder_id"/>
                    <field name="new_holder_id"/>
                    <field name="previous_department_id"/>
                    <field name="new_department_id"/>
                    <field name="condition"/>
                    <field name="notes"/>
                    <field name="logged_by_id"/>
                </list>
            </field>
        </record>

        <record id="view_asset_custody_log_search" model="ir.ui.view">
            <field name="name">institutional.asset.custody.log.search</field>
            <field name="model">institutional.asset.custody.log</field>
            <field name="arch" type="xml">
                <search string="Search Lifecycle Logs">
                    <field name="asset_id"/>
                    <field name="serial_number"/>
                    <field name="new_holder_id"/>
                    <field name="new_department_id"/>
                    <filter string="Acquisition" name="filter_acq" domain="[('event_type', '=', 'acquisition')]"/>
                    <filter string="Check-Out / Issue" name="filter_issue" domain="[('event_type', '=', 'issue')]"/>
                    <filter string="Returned" name="filter_return" domain="[('event_type', '=', 'return')]"/>
                    <filter string="Transfer" name="filter_transfer" domain="[('event_type', '=', 'transfer')]"/>
                    <separator/>
                    <filter string="Component Composed / Added" name="filter_comp_add" domain="[('event_type', '=', 'component_added')]"/>
                    <filter string="Component Decomposed / Removed" name="filter_comp_rem" domain="[('event_type', '=', 'component_removed')]"/>
                    <filter string="Component Swapped / Transferred" name="filter_comp_swap" domain="[('event_type', '=', 'component_swapped')]"/>
                    <group>
                        <filter string="Asset" name="group_asset" context="{'group_by': 'asset_id'}"/>
                        <filter string="Event Type" name="group_event" context="{'group_by': 'event_type'}"/>
                        <filter string="Holder" name="group_holder" context="{'group_by': 'new_holder_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Component History Log Tree View -->
        <record id="view_asset_component_history_tree" model="ir.ui.view">
            <field name="name">institutional.asset.component.history.tree</field>
            <field name="model">institutional.asset.component.history</field>
            <field name="arch" type="xml">
                <list string="IT Component Composition &amp; Transfer Logs">
                    <field name="swap_date"/>
                    <field name="action_type" widget="badge"/>
                    <field name="component_type"/>
                    <field name="old_component_name"/>
                    <field name="new_component_name"/>
                    <field name="source_asset_id"/>
                    <field name="dest_asset_id"/>
                    <field name="technician_id"/>
                    <field name="reason"/>
                </list>
            </field>
        </record>

        <!-- Search View for Assets -->
        <record id="view_asset_item_search" model="ir.ui.view">
            <field name="name">institutional.asset.item.search</field>
            <field name="model">institutional.asset.item</field>
            <field name="arch" type="xml">
                <search string="Search Assets">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="serial_number"/>
                    <field name="assigned_user_id"/>
                    <field name="department_id"/>
                    <separator/>
                    <filter string="Available" name="filter_available" domain="[('status', '=', 'available')]"/>
                    <filter string="Currently Issued" name="filter_issued" domain="[('status', '=', 'issued')]"/>
                    <filter string="Under Maintenance" name="filter_maintenance" domain="[('status', '=', 'maintenance')]"/>
                    <separator/>
                    <filter string="Intact" name="filter_intact" domain="[('condition', '=', 'intact')]"/>
                    <filter string="Used" name="filter_used" domain="[('condition', '=', 'used')]"/>
                    <filter string="Damaged" name="filter_damaged" domain="[('condition', '=', 'damaged')]"/>
                    <separator/>
                    <group>
                        <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                        <filter string="Current Holder" name="group_holder" context="{'group_by': 'assigned_user_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Condition" name="group_condition" context="{'group_by': 'condition'}"/>
                        <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_asset_items" model="ir.actions.act_window">
            <field name="name">Serialized Assets &amp; Devices</field>
            <field name="res_model">institutional.asset.item</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register and track unit-level assets (Cameras, Computers, LAN boxes).
                </p>
            </field>
        </record>

        <record id="action_asset_checked_out" model="ir.actions.act_window">
            <field name="name">Assets Currently Checked Out</field>
            <field name="res_model">institutional.asset.item</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('status', '=', 'issued')]</field>
            <field name="context">{'search_default_filter_issued': 1, 'search_default_group_holder': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No assets are currently checked out.
                </p>
            </field>
        </record>

        <record id="action_asset_custody_logs" model="ir.actions.act_window">
            <field name="name">Asset Lifecycle &amp; Custody Audit Logs</field>
            <field name="res_model">institutional.asset.custody.log</field>
            <field name="view_mode">list,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Audit log of asset acquisitions, holder check-outs, store returns, and custody transfers.
                </p>
            </field>
        </record>

        <record id="action_asset_component_history" model="ir.actions.act_window">
            <field name="name">IT Component Composition &amp; Transfer History Logs</field>
            <field name="res_model">institutional.asset.component.history</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Items for Asset & IT Tracking -->
        <menuitem id="menu_asset_items_list"
                  name="Serialized Assets (Camera, LAN, PC)"
                  parent="menu_asset_category"
                  action="action_asset_items"
                  sequence="10"/>

        <menuitem id="menu_asset_checked_out"
                  name="Assets Currently Checked Out"
                  parent="menu_asset_category"
                  action="action_asset_checked_out"
                  sequence="15"/>

        <menuitem id="menu_asset_custody_logs_item"
                  name="Asset Lifecycle &amp; Custody Audit Logs"
                  parent="menu_asset_category"
                  action="action_asset_custody_logs"
                  sequence="20"/>

        <menuitem id="menu_asset_component_history_list"
                  name="IT Hardware Composition &amp; Transfer Logs"
                  parent="menu_asset_category"
                  action="action_asset_component_history"
                  sequence="25"/>

    </data>
</odoo>
