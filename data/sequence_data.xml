<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for Requisitions -->
        <record id="seq_store_requisition" model="ir.sequence">
            <field name="name">Store Requisition Sequence</field>
            <field name="code">institutional.store.requisition</field>
            <field name="prefix">REQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Assets -->
        <record id="seq_asset_item" model="ir.sequence">
            <field name="name">Asset Tag Sequence</field>
            <field name="code">institutional.asset.item</field>
            <field name="prefix">AST/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
