<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_low_stock_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mb-4">
                        <h2 class="text-danger">LOW STOCK REORDER THRESHOLD ALERT REPORT</h2>
                        <p class="text-muted">Central Store Office — Inventory Replenishment Audit</p>
                    </div>

                    <table class="table table-bordered table-striped mt-4">
                        <thead class="table-danger">
                            <tr>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th class="text-end">On Hand Qty</th>
                                <th class="text-end">Min Threshold</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <t t-set="orderpoints" t-value="doc.product_variant_ids.orderpoint_ids if hasattr(doc, 'product_variant_ids') else []"/>
                                <t t-set="min_qty" t-value="sum(orderpoints.mapped('product_min_qty')) if orderpoints else 0.0"/>
                                <t t-set="is_low" t-value="doc.qty_available &lt; min_qty"/>
                                <tr>
                                    <td><span t-field="doc.display_name"/></td>
                                    <td><span t-field="doc.categ_id.name"/></td>
                                    <td class="text-end font-weight-bold" t-att-class="'text-danger' if is_low else ''"><span t-field="doc.qty_available"/></td>
                                    <td class="text-end"><span t-esc="min_qty"/></td>
                                    <td class="text-center">
                                        <t t-if="is_low">
                                            <span class="badge bg-danger">Low</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-success">OK</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row mt-5 pt-4">
                        <div class="col-6">
                            <strong>Report Generated:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/><br/>
                            <strong>Generated By:</strong> Store Incharge
                        </div>
                        <div class="col-6 text-end">
                            _______________________<br/>
                            <strong>Procurement Head Signature</strong>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
